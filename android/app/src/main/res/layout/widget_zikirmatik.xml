<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_zikirmatik_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="10dp">

    <ProgressBar
        android:id="@+id/widget_zikirmatik_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:max="100"
        android:rotation="-90" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_zikirmatik_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#283038"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_zikirmatik_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#283038"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_zikirmatik_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#56616b"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>